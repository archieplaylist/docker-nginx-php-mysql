#!/usr/bin/env bash

# ============================================================================
# Production Environment Configuration
# ============================================================================
# Copy this file to .env.prod, fill in real values, then run:
#
#     docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#         --profile mariadb up -d
#
# IMPORTANT: Never commit .env.prod to version control!
# ============================================================================

# Nginx
NGINX_HOST=yourdomain.com

# PHP
PHP_VERSION=8.5

# ---------------------------------------------------------------------------
# Database — pick ONE:
#   1. MariaDB (profile: mariadb)  — port 3306
#   2. MySQL   (profile: mysql)    — port 3306
#   3. PostgreSQL (profile: pg)    — port 5432
#
# Only activate one at a time (MariaDB and MySQL share port 3306).
# Fill in the section for your chosen database and leave the rest.
# ---------------------------------------------------------------------------

# MariaDB
MARIADB_VERSION=11
MARIADB_HOST=mariadb
MARIADB_DATABASE=app_production
MARIADB_ROOT_USER=root
MARIADB_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MARIADB_USER=app_user
MARIADB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# MySQL
MYSQL_VERSION=8
MYSQL_HOST=mysql
MYSQL_DATABASE=app_production
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MYSQL_USER=app_user
MYSQL_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# PostgreSQL
POSTGRES_VERSION=16
POSTGRES_HOST=postgres
POSTGRES_DB=app_production
POSTGRES_USER=app_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
